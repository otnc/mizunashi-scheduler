{
  "name": "@mizunashi/api-client",
  "version": "1.0.0",
  "description": "水無海浜温泉 入浴可能時間 API の薄いクライアント（非公式）",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otnc/mizunashi-scheduler.git",
    "directory": "packages/api-client"
  },
  "homepage": "https://github.com/otnc/mizunashi-scheduler#readme",
  "keywords": [
    "mizunashi",
    "hakodate",
    "onsen",
    "api",
    "client"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "author": "otoneko.",
  "scripts": {
    "build": "tsup",
    "verify:package": "publint --strict",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mizunashi/api-types": "workspace:^"
  },
  "devDependencies": {
    "publint": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
